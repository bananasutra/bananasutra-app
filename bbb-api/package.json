{
  "name": "bbb-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bertrand the Banana Butler Cloudflare Worker API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:bbb": "tsx --test src/*.test.ts",
    "test:prompt": "tsx --test src/system-prompt.test.ts src/recommendation-context.test.ts",
    "verify:required-scripts": "node scripts/verify-required-scripts.mjs",
    "build:library": "tsx scripts/build-library-data.ts",
    "logs:local": "bash scripts/bbb-logs.sh logs local",
    "logs:remote": "bash scripts/bbb-logs.sh logs remote",
    "logs:remote:not-me": "bash scripts/bbb-logs-not-me.sh",
    "logs:cleanup:local": "bash scripts/bbb-logs.sh cleanup local",
    "logs:cleanup:remote": "bash scripts/bbb-logs.sh cleanup remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/node": "^25.0.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
}
