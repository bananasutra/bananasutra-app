{
  "name": "banana-catalog-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:bbb": "tsx --test src/bbb/BbbChatWidget.test.ts",
    "test:analytics": "tsx --test src/lib/analytics.test.ts",
    "build": "tsc -b && vite build && node scripts/prerender-html.mjs && node scripts/inline-critical-css.mjs && node scripts/generate-og-images.mjs && node scripts/generate-seo-metadata.mjs && node scripts/generate-sitemap.mjs && node scripts/sync-catalog-data-dist.mjs",
    "prerender": "node scripts/prerender-html.mjs",
    "prerender:pilot": "PRERENDER_PILOT=1 node scripts/prerender-html.mjs",
    "verify:seo": "node scripts/verify-seo-artifacts.mjs",
    "og:samples": "node scripts/preview-og-samples.mjs",
    "build:fresh-og": "FORCE_OG=1 npm run build",
    "build:skip-og": "SKIP_OG=1 npm run build",
    "build:data": "python3 scripts/build_artifacts.py",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:dist": "serve dist -l tcp://0.0.0.0:5174 -n"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "beasties": "^0.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "react-helmet-async": "^3.0.0",
    "satori": "^0.26.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-node": "^6.0.0"
  }
}
